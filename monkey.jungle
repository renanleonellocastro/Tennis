project.manifest = manifest.xml

# Source and base resources use the default paths (source, resources), so
# the per language string folders (resources-por, resources-spa, ...) are
# picked up automatically. Base resources hold the strings and the launcher
# icon. Tennis ships no per device resources yet.

# The source path is spelled out because the default one scans the whole
# project folder, including any untracked folder that holds a second copy
# of the sources (a git worktree, for example), and then every symbol is
# defined twice.
base.sourcePath = source

# Key labels. Watches with a vector font turn real text along the round
# edge (keyArc). The ones below have no such font and draw images made by
# tools/key_labels.py instead (keyImages): one folder per screen width and
# language, so a watch loads only its own. make key-labels writes this
# block's lines; make check fails when one is missing.
base.excludeAnnotations = keyImages
fr55.excludeAnnotations = keyArc
fr55.resourcePath = $(fr55.resourcePath);keylabels/208/eng
fr55.lang.spa = $(fr55.lang.spa);keylabels/208/spa
fr55.lang.fre = $(fr55.lang.fre);keylabels/208/fre
fr55.lang.deu = $(fr55.lang.deu);keylabels/208/deu
fr55.lang.ita = $(fr55.lang.ita);keylabels/208/ita
